# ---------------------------------------------------------------------------
# Example environment variables for SQL-Connection-Module
#
# Copy this file to `.env` (which is git-ignored) and fill in real values.
# These are NOT loaded automatically by the library; read them in your own code
# (e.g. with python-dotenv / os.environ) and pass them to get_connector(...).
# ---------------------------------------------------------------------------

# --- SQLite --------------------------------------------------------------
SQLITE_PATH=examples/toys_and_models.sqlite

# --- PostgreSQL ----------------------------------------------------------
PG_HOST=localhost
PG_PORT=5432
PG_DBNAME=mydb
PG_USER=myuser
PG_PASSWORD=
PG_SSLMODE=

# --- MySQL / MariaDB -----------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=mydb
MYSQL_USER=myuser
MYSQL_PASSWORD=

# --- SQL Server ----------------------------------------------------------
MSSQL_SERVER=localhost
MSSQL_DATABASE=MyDb
MSSQL_USER=sa
MSSQL_PASSWORD=
MSSQL_DRIVER=ODBC Driver 17 for SQL Server
MSSQL_TRUSTED_CONNECTION=false

# --- Oracle --------------------------------------------------------------
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=orclpdb1
ORACLE_USER=scott
ORACLE_PASSWORD=

# --- Snowflake -----------------------------------------------------------
SNOWFLAKE_ACCOUNT=xy12345.us-east-1
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=WH
SNOWFLAKE_DATABASE=DB
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_ROLE=

# --- Amazon Redshift -----------------------------------------------------
REDSHIFT_HOST=mycluster.abcd123.redshift.amazonaws.com
REDSHIFT_PORT=5439
REDSHIFT_DBNAME=dev
REDSHIFT_USER=awsuser
REDSHIFT_PASSWORD=
REDSHIFT_SSLMODE=require
